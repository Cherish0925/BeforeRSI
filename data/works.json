{
  "schema_version": "1.0.0",
  "updated": "2026-10-18",
  "depth_definitions": {
    "conceptual": "Qualitative or theoretical statement without an executable persistent update.",
    "external_optimization": "A fixed optimizer improves an external target.",
    "adaptation": "The system learns or searches for current or future tasks under a fixed update procedure.",
    "persistent": "A versioned modification survives into later tasks.",
    "transfer": "A persistent modification is reported to improve untouched tasks, models, or environments.",
    "multi_generation": "Several successor generations or lineage steps are reported.",
    "one_round_coevolution": "Model–harness interaction is demonstrated for one full build/update/rebuild round.",
    "recursive_theory": "A formal result concerns improvement of the self-modifying procedure.",
    "evaluation": "The work primarily evaluates, audits, or bounds self-improvement claims."
  },
  "evidence_definitions": {
    "reported": "Stated by the original authors or repository.",
    "reproduced": "Public artifacts were rerun with materially matching results.",
    "replicated": "An independent implementation supports the same conclusion.",
    "contradicted": "A controlled result conflicts with the claim.",
    "open": "Available evidence does not decide the claim."
  },
