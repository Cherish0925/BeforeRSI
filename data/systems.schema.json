{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cherish0925/BeforeRSI/data/systems.schema.json",
  "title": "BeforeRSI public-system catalog",
  "type": "object",
  "required": [
    "schema_version",
    "updated",
    "status_definitions",
    "relation_definitions",
    "systems"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "status_definitions": {
      "type": "object",
      "required": [
        "reported",
        "reproduced",
        "replicated",
        "contradicted",
        "open"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "relation_definitions": {
      "type": "object",
      "required": [
        "direct_candidate",
        "precursor",
        "adjacent",
        "evaluation"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/system"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "type",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "repository",
            "paper",
            "project_page",
            "proceedings",
            "survey"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "system": {
      "type": "object",
      "required": [
        "id",
        "name",
        "track",
        "relation_to_rsi",
        "claimed_changed_objects",
        "evidence_status",
        "before_rsi_audit",
        "central_question",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "track": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "relation_to_rsi": {
          "enum": [
            "direct_candidate",
            "precursor",
            "adjacent",
            "evaluation"
          ]
        },
        "claimed_changed_objects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          }
        },
        "evidence_status": {
          "enum": [
            "reported",
            "reproduced",
            "replicated",
            "contradicted",
            "open"
          ]
        },
        "before_rsi_audit": {
          "enum": [
            "pending",
            "in_progress",
            "complete"
          ]
        },
        "central_question": {
          "type": "string",
          "minLength": 10
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  }
}
