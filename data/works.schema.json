{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Cherish0925/BeforeRSI/data/works.schema.json","title":"BeforeRSI work catalog","type":"object","required":["schema_version","updated","depth_definitions","evidence_definitions","works"],"additionalProperties":false,"properties":{"schema_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"updated":{"type":"string","format":"date"},"depth_definitions":{"type":"object","minProperties":1,"additionalProperties":{"type":"string"}},"evidence_definitions":{"type":"object","required":["reported","reproduced","replicated","contradicted","open"],"additionalProperties":{"type":"string"}},"works":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/work"}}},"$defs":{"source":{"type":"object","required":["type","url"],"additionalProperties":false,"properties":{"type":{"enum":["paper","repository","project_page","proceedings"]},"url":{"type":"string","pattern":"^https://"}}},"work":{"type":"object","required":["id","name","year","role","reported_depth","changed_objects","evidence_status","audit_status","central_limit","sources"],"additionalProperties":false,"properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"name":{"type":"string","minLength":1},"year":{"type":"integer","minimum":1900,"maximum":2100},"role":{"type":"string","pattern":"^[a-z0-9]+(?:_[a-z0-9]+)*$"},"reported_depth":{"type":"string","minLength":1},"changed_objects":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:_[a-z0-9]+)*$"}},"evidence_status":{"enum":["reported","reproduced","replicated","contradicted","open"]},"audit_status":{"enum":["pending","in_progress","complete"]},"central_limit":{"type":"string","minLength":20},"sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}}}}}}
